# Smart Traffic Analysis System — Environment Configuration
# Copy this file to .env and fill in your values.
# The app loads this automatically on startup.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (no setup required — default):
DATABASE_URL=sqlite:///traffic.db

# PostgreSQL (for multi-camera production deployments):
# DATABASE_URL=postgresql://username:password@localhost:5432/traffic_db

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO

